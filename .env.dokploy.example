# Generate a complete secret-filled version with:
# node scripts/generate-dokploy-env.mjs https://crm.example.com https://supabase.example.com admin@example.com

# Public URLs
SITE_URL=https://crm.example.com
ADDITIONAL_REDIRECT_URLS=https://crm.example.com/**
SUPABASE_PUBLIC_URL=https://supabase.example.com
API_EXTERNAL_URL=https://supabase.example.com/auth/v1
NEXT_PUBLIC_APP_LOCALE=en
NEXT_PUBLIC_SIGNUP_ENABLED=false

# WACRM secrets
ENCRYPTION_KEY=replace-with-64-hex-character-key
META_APP_SECRET=replace-with-meta-app-secret
# META_APP_ID=replace-with-meta-app-id
ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=replace-with-long-random-secret

# Supabase database and API keys
POSTGRES_PASSWORD=replace-with-long-random-password
POSTGRES_DB=postgres
POSTGRES_PORT=5432
JWT_SECRET=replace-with-at-least-32-character-secret
JWT_EXPIRY=3600
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt
SECRET_KEY_BASE=replace-with-at-least-64-character-secret
REALTIME_DB_ENC_KEY=replace-with-exactly-16-characters
PG_META_CRYPTO_KEY=replace-with-at-least-32-character-secret
S3_PROTOCOL_ACCESS_KEY_ID=replace-with-32-hex-characters
S3_PROTOCOL_ACCESS_KEY_SECRET=replace-with-64-hex-characters

# Supabase Studio login
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=replace-with-strong-dashboard-password
STUDIO_DEFAULT_ORGANIZATION=WACRM
STUDIO_DEFAULT_PROJECT=WACRM Production

# Supabase Auth: public registration stays closed
DISABLE_SIGNUP=true
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=admin@example.com
SMTP_PASS=replace-with-google-app-password
SMTP_SENDER_NAME=WACRM

# REST API
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public
