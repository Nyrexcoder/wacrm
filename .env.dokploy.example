# Public values (also passed as Docker build arguments)
NEXT_PUBLIC_SUPABASE_URL=https://supabase.example.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-publishable-or-anon-key
NEXT_PUBLIC_SITE_URL=https://crm.example.com
NEXT_PUBLIC_APP_LOCALE=en
NEXT_PUBLIC_SIGNUP_ENABLED=false

# Server-only secrets
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-or-secret-key
ENCRYPTION_KEY=replace-with-64-hex-character-key
META_APP_SECRET=replace-with-meta-app-secret

# Optional production features
# META_APP_ID=replace-with-meta-app-id
# ALLOWED_INVITE_HOSTS=crm.example.com
# AUTOMATION_CRON_SECRET=replace-with-a-long-random-secret
# AI_REQUEST_TIMEOUT_MS=30000
# AI_CONTEXT_MESSAGE_LIMIT=20
